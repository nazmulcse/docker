# Docker Environment Variables
# These variables are used by the docker-compose.yml file

# Application User Group ID (for volume permissions)
# You can find your host user's group ID by running 'id -g'
WWWGROUP=1000

# Database Configuration
DB_DATABASE=laravel_octane
DB_USERNAME=laravel_user
DB_PASSWORD=secret_db_password

# Redis Configuration
REDIS_PASSWORD=secret_redis_password

# Octane Port
APP_PORT=8000
PMA_PORT=8080

# Laravel Application Key (You should generate this in your Laravel project)
APP_KEY=base64:SomeRandomStringForLaravelAppKey=
